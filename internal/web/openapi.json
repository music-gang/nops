{
  "openapi": "3.1.0",
  "info": {
    "title": "Nops API",
    "version": "1",
    "license": { "name": "Apache 2.0", "identifier": "Apache-2.0" },
    "description": "Read jobs and deployments, act on them, and manage ACL policies, binding rules and tokens. A token does what its ACL policies allow, with the dashboard's rules."
  },
  "servers": [{ "url": ".." }],
  "security": [{ "bearer": [] }],
  "paths": {
    "/api/openapi.json": {
      "get": {
        "summary": "This description",
        "operationId": "getOpenAPI",
        "responses": {
          "200": {
            "description": "The OpenAPI description of the API.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "Every managed job, orphans included",
        "operationId": "listJobs",
        "responses": {
          "200": {
            "description": "The jobs, by namespace and name.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["jobs"],
                  "properties": { "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/jobs/{namespace}/{job}": {
      "get": {
        "summary": "One job with its drift, hold, and deployments",
        "operationId": "getJob",
        "parameters": [{ "$ref": "#/components/parameters/Namespace" }, { "$ref": "#/components/parameters/Job" }],
        "responses": {
          "200": {
            "description": "The job.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobDetail" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/deployments": {
      "get": {
        "summary": "The active deployments and the latest finished ones, newest first",
        "operationId": "listDeployments",
        "responses": {
          "200": {
            "description": "The deployments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["deployments"],
                  "properties": {
                    "deployments": { "type": "array", "items": { "$ref": "#/components/schemas/Deployment" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/deployments/{id}": {
      "get": {
        "summary": "One deployment with its redacted diff, hook runs, and events",
        "operationId": "getDeployment",
        "parameters": [{ "$ref": "#/components/parameters/DeploymentID" }],
        "responses": {
          "200": {
            "description": "The deployment.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeploymentDetail" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/deployments/{id}/approve": {
      "post": {
        "summary": "Approve a deployment",
        "operationId": "approveDeployment",
        "parameters": [{ "$ref": "#/components/parameters/DeploymentID" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpecHash" } } }
        },
        "responses": {
          "204": { "description": "Approved." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/deployments/{id}/reject": {
      "post": {
        "summary": "Reject a deployment",
        "operationId": "rejectDeployment",
        "parameters": [{ "$ref": "#/components/parameters/DeploymentID" }],
        "responses": {
          "204": { "description": "Rejected." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/deployments/{id}/promote": {
      "post": {
        "summary": "Promote the canaries of a deployment that waits for it",
        "operationId": "promoteDeployment",
        "parameters": [{ "$ref": "#/components/parameters/DeploymentID" }],
        "responses": {
          "204": { "description": "Promoted." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/deployments/{id}/retry": {
      "post": {
        "summary": "Retry a failed or rejected deployment",
        "operationId": "retryDeployment",
        "parameters": [{ "$ref": "#/components/parameters/DeploymentID" }],
        "responses": {
          "200": {
            "description": "The new deployment.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeploymentID" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/jobs/{namespace}/{job}/pause": {
      "post": {
        "summary": "Pause a job",
        "operationId": "pauseJob",
        "parameters": [{ "$ref": "#/components/parameters/Namespace" }, { "$ref": "#/components/parameters/Job" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pause" } } }
        },
        "responses": {
          "204": { "description": "Paused." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/jobs/{namespace}/{job}/resume": {
      "post": {
        "summary": "Resume a paused job",
        "operationId": "resumeJob",
        "parameters": [{ "$ref": "#/components/parameters/Namespace" }, { "$ref": "#/components/parameters/Job" }],
        "responses": {
          "204": { "description": "Resumed." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/jobs/{namespace}/{job}/deploy-now": {
      "post": {
        "summary": "Deploy a job outside its sync window",
        "operationId": "deployJobNow",
        "parameters": [{ "$ref": "#/components/parameters/Namespace" }, { "$ref": "#/components/parameters/Job" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpecHash" } } }
        },
        "responses": {
          "200": {
            "description": "The deployment the request led to. Its id is empty when the next detection cycle starts it.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeploymentID" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/fetch": {
      "post": {
        "summary": "Ask for a git poll now",
        "operationId": "fetchGit",
        "responses": {
          "202": { "description": "The poll is asked for; it runs on its own." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/acl/policies": {
      "get": {
        "summary": "The ACL policies: all for a management token, the ones a client token carries",
        "operationId": "listACLPolicies",
        "responses": {
          "200": {
            "description": "The ACL policies, by name.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["acl_policies"], "properties": { "acl_policies": { "type": "array", "items": { "$ref": "#/components/schemas/ACLPolicy" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/acl/policies/{name}": {
      "get": {
        "summary": "One ACL policy with its rules",
        "operationId": "getACLPolicy",
        "parameters": [{ "$ref": "#/components/parameters/PolicyName" }],
        "responses": {
          "200": {
            "description": "The ACL policy.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ACLPolicy" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "summary": "Create an ACL policy or replace it",
        "operationId": "putACLPolicy",
        "parameters": [{ "$ref": "#/components/parameters/PolicyName" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ACLPolicyBody" } } }
        },
        "responses": {
          "200": {
            "description": "The ACL policy as saved.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ACLPolicy" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "summary": "Delete an ACL policy",
        "operationId": "deleteACLPolicy",
        "parameters": [{ "$ref": "#/components/parameters/PolicyName" }],
        "responses": {
          "204": { "description": "Deleted." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/acl/binding-rules": {
      "get": {
        "summary": "Every binding rule",
        "operationId": "listBindingRules",
        "responses": {
          "200": {
            "description": "The binding rules, oldest first.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["binding_rules"], "properties": { "binding_rules": { "type": "array", "items": { "$ref": "#/components/schemas/BindingRule" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "summary": "Create a binding rule",
        "operationId": "createBindingRule",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingRuleBody" } } }
        },
        "responses": {
          "201": {
            "description": "The binding rule, with its ID.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingRule" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/acl/binding-rules/{id}": {
      "get": {
        "summary": "One binding rule",
        "operationId": "getBindingRule",
        "parameters": [{ "$ref": "#/components/parameters/BindingRuleID" }],
        "responses": {
          "200": {
            "description": "The binding rule.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingRule" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "summary": "Replace a binding rule",
        "operationId": "putBindingRule",
        "parameters": [{ "$ref": "#/components/parameters/BindingRuleID" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingRuleBody" } } }
        },
        "responses": {
          "200": {
            "description": "The binding rule as saved.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingRule" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "summary": "Delete a binding rule",
        "operationId": "deleteBindingRule",
        "parameters": [{ "$ref": "#/components/parameters/BindingRuleID" }],
        "responses": {
          "204": { "description": "Deleted." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/acl/tokens": {
      "get": {
        "summary": "Every token",
        "operationId": "listACLTokens",
        "responses": {
          "200": {
            "description": "The tokens, newest first.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["tokens"], "properties": { "tokens": { "type": "array", "items": { "$ref": "#/components/schemas/ACLToken" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "summary": "Create a token",
        "operationId": "createACLToken",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ACLTokenBody" } } }
        },
        "responses": {
          "201": {
            "description": "The token, with its secret.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewACLToken" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/acl/tokens/{accessor_id}": {
      "get": {
        "summary": "One token",
        "operationId": "getACLToken",
        "parameters": [{ "$ref": "#/components/parameters/AccessorID" }],
        "responses": {
          "200": {
            "description": "The token.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ACLToken" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "summary": "Revoke a token",
        "operationId": "revokeACLToken",
        "parameters": [{ "$ref": "#/components/parameters/AccessorID" }],
        "responses": {
          "204": { "description": "Revoked." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/acl/token/self": {
      "get": {
        "summary": "The token of the request",
        "operationId": "getSelfACLToken",
        "responses": {
          "200": {
            "description": "The token.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ACLToken" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/acl/changes": {
      "get": {
        "summary": "The latest changes to ACL policies and tokens",
        "operationId": "listACLChanges",
        "responses": {
          "200": {
            "description": "The changes, newest first.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["changes"], "properties": { "changes": { "type": "array", "items": { "$ref": "#/components/schemas/Change" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "description": "A token from the dashboard's Administration page." }
    },
    "parameters": {
      "Namespace": { "name": "namespace", "in": "path", "required": true, "schema": { "type": "string" } },
      "Job": { "name": "job", "in": "path", "required": true, "schema": { "type": "string" } },
      "DeploymentID": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "PolicyName": { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } },
      "AccessorID": { "name": "accessor_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "BindingRuleID": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is not what the endpoint takes.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "No valid token: it is missing, unknown, expired, or revoked.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "The token is valid, and its ACL policies do not allow this.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "The job, deployment, ACL policy or token does not exist.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "The state moved since you read it.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ServerError": {
        "description": "Nops hit an error and logged it.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "SpecHash": {
        "type": "object",
        "required": ["spec_hash"],
        "properties": { "spec_hash": { "type": "string", "description": "The spec hash you read." } }
      },
      "Pause": {
        "type": "object",
        "properties": { "reason": { "type": "string", "maxLength": 500, "description": "At most 500 bytes." } }
      },
      "DeploymentID": {
        "type": "object",
        "required": ["deployment_id"],
        "properties": { "deployment_id": { "type": "string" } }
      },
      "Hold": {
        "type": "object",
        "required": ["kind", "reason"],
        "properties": {
          "kind": { "type": "string" },
          "reason": { "type": "string" },
          "by": { "type": "string" },
          "since": { "type": "string", "format": "date-time" }
        }
      },
      "Deployment": {
        "type": "object",
        "required": ["id", "namespace", "job", "state", "policy", "spec_hash", "commit_sha", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "namespace": { "type": "string" },
          "job": { "type": "string" },
          "state": { "type": "string" },
          "policy": { "type": "string", "enum": ["auto", "approval", "none"] },
          "spec_hash": { "type": "string" },
          "commit_sha": { "type": "string" },
          "commit_subject": { "type": "string" },
          "commit_author": { "type": "string" },
          "error": { "type": "string" },
          "decided_by": { "type": "string" },
          "decided_at": { "type": "string", "format": "date-time" },
          "retry_of": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Job": {
        "type": "object",
        "required": ["namespace", "job", "policy", "sync", "drift"],
        "properties": {
          "namespace": { "type": "string" },
          "job": { "type": "string" },
          "policy": { "type": "string", "enum": ["auto", "approval", "none"] },
          "sync": {
            "type": "string",
            "description": "The sync state of the job: invalid, paused, blocked, orphan, pending, deploying, held, drift, or sync. Empty for a job gone from git and from Nomad."
          },
          "drift": { "type": "boolean" },
          "spec_hash": { "type": "string", "description": "What a deployment of the job would have now: the hash Deploy now asks for." },
          "blocked_by": { "type": "string" },
          "hold": { "$ref": "#/components/schemas/Hold" },
          "last_deployment": { "$ref": "#/components/schemas/Deployment" }
        }
      },
      "Issue": {
        "type": "object",
        "required": ["severity", "key", "message"],
        "properties": {
          "severity": { "type": "string" },
          "key": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "JobDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Job" },
          {
            "type": "object",
            "required": ["deployments"],
            "properties": {
              "file": { "type": "string" },
              "diff": { "type": "object", "description": "The redacted plan diff of the drift, as Nomad's JSON. Absent without drift." },
              "issues": { "type": "array", "items": { "$ref": "#/components/schemas/Issue" } },
              "deployments": { "type": "array", "items": { "$ref": "#/components/schemas/Deployment" } }
            }
          }
        ]
      },
      "Event": {
        "type": "object",
        "required": ["time", "from", "to", "actor"],
        "properties": {
          "time": { "type": "string", "format": "date-time" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "actor": { "type": "string" },
          "accessor_id": { "type": "string", "description": "The token the action was made with. Absent for Nops itself." },
          "message": { "type": "string" }
        }
      },
      "HookRun": {
        "type": "object",
        "required": ["phase", "job", "state"],
        "properties": {
          "phase": { "type": "string" },
          "job": { "type": "string" },
          "state": { "type": "string" },
          "error": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" }
        }
      },
      "DeploymentDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Deployment" },
          {
            "type": "object",
            "required": ["events", "hook_runs"],
            "properties": {
              "diff": { "type": "object", "description": "The redacted plan diff, as Nomad's JSON. Absent when there is none." },
              "events": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } },
              "hook_runs": { "type": "array", "items": { "$ref": "#/components/schemas/HookRun" } }
            }
          }
        ]
      },
      "ACLPolicy": {
        "type": "object",
        "required": ["name", "description", "rules", "created_at", "modified_at"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "rules": { "type": "string", "description": "The rules, in HCL." },
          "created_at": { "type": "string", "format": "date-time" },
          "modified_at": { "type": "string", "format": "date-time" }
        }
      },
      "ACLPolicyBody": {
        "type": "object",
        "required": ["rules"],
        "properties": {
          "description": { "type": "string" },
          "rules": { "type": "string", "description": "The rules, in HCL. Rules that do not parse are refused and nothing is saved." }
        }
      },
      "BindingRule": {
        "type": "object",
        "required": ["id", "description", "auth_method", "selector", "bind_type", "created_at", "modified_at"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "auth_method": { "type": "string", "enum": ["oidc", "basic"] },
          "selector": { "type": "string", "description": "A go-bexpr expression on the claims of a login: value.username, value.sub and list.groups. Empty matches every login of the auth method." },
          "bind_type": { "type": "string", "enum": ["policy", "management"] },
          "bind_name": { "type": "string", "description": "The ACL policy a policy rule binds. Absent for management." },
          "created_at": { "type": "string", "format": "date-time" },
          "modified_at": { "type": "string", "format": "date-time" }
        }
      },
      "BindingRuleBody": {
        "type": "object",
        "required": ["auth_method", "bind_type"],
        "properties": {
          "description": { "type": "string", "maxLength": 200 },
          "auth_method": { "type": "string", "enum": ["oidc", "basic"] },
          "selector": { "type": "string", "maxLength": 1024, "description": "Refused if it does not parse or reads a claim that does not exist." },
          "bind_type": { "type": "string", "enum": ["policy", "management"] },
          "bind_name": { "type": "string", "description": "The ACL policy to bind, which must exist. Empty for management." }
        }
      },
      "ACLToken": {
        "type": "object",
        "required": ["accessor_id", "name", "type", "origin", "policies", "created_at"],
        "properties": {
          "accessor_id": { "type": "string", "description": "Public: it names the token in logs and the audit, and grants nothing." },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["management", "client"] },
          "origin": { "type": "string", "enum": ["login", "created"], "description": "A login made a session token; a person or a token created the others." },
          "identity": { "type": "string", "description": "The person a session token stands for. Absent for a created token." },
          "policies": { "type": "array", "items": { "type": "string" }, "description": "The ACL policies a client token carries, by name." },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time", "description": "Absent for a token that never expires." },
          "creator_accessor_id": { "type": "string", "description": "The token that made this one. It stays after that token is gone." },
          "creator_name": { "type": "string" },
          "creator_identity": { "type": "string", "description": "The person who created the token, when it was one." }
        }
      },
      "NewACLToken": {
        "allOf": [
          { "$ref": "#/components/schemas/ACLToken" },
          {
            "type": "object",
            "required": ["secret"],
            "properties": { "secret": { "type": "string", "description": "The secret. Nops shows it once and keeps only its hash." } }
          }
        ]
      },
      "ACLTokenBody": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 100 },
          "type": { "type": "string", "enum": ["management", "client"], "description": "Default client." },
          "policies": { "type": "array", "items": { "type": "string" }, "description": "The ACL policies of a client token. Each must exist." },
          "expires_in": { "type": "string", "description": "A duration such as 720h. Empty: the token never expires." }
        }
      },
      "Change": {
        "type": "object",
        "required": ["time", "accessor_id", "actor", "action", "kind", "object"],
        "properties": {
          "time": { "type": "string", "format": "date-time" },
          "accessor_id": { "type": "string", "description": "The token used. Empty when the change was made without one." },
          "actor": { "type": "string" },
          "identity": { "type": "string", "description": "The person behind the token used. Absent when it was not a login." },
          "action": { "type": "string", "enum": ["create", "update", "delete", "revoke"] },
          "kind": { "type": "string", "enum": ["acl-policy", "binding-rule", "token"] },
          "object": { "type": "string", "description": "The name of an ACL policy, the ID of a binding rule, or the accessor ID of a token." }
        }
      }
    }
  }
}
